# Neon Postgres connection string (pooled connection recommended)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=verify-full"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# Seed admin (used once by prisma/seed.ts to create the first مدير النظام)
SEED_ADMIN_NAME="مدير النظام"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""

# Cloudinary (Phase 3 — product image uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Required before deleting an invoice, customer, or payment
DELETE_CONFIRM_PASSWORD=""

# DeepSeek API key — powers the AI purchase-invoice scanner
# (/dashboard/purchases/scan). Server-side only; never exposed to the browser.
# Get one at https://platform.deepseek.com. Uses the "deepseek-flash" vision model.
DEEPSEEK_API_KEY=""

# Optional — only needed if your Postgres client requires an unpooled
# connection (e.g. Prisma <5.10). Use your own project's unpooled URL here.
# DATABASE_URL_UNPOOLED=""

# Telegram AI Voice Invoice — bot token from @BotFather. Server-side only.
TELEGRAM_BOT_TOKEN=""

# The bot's @username (without the @), used to build the t.me/<bot>?start=...
# deep link shown in an admin's own account settings to connect Telegram.
TELEGRAM_BOT_USERNAME=""

# Secret string you choose yourself and pass as secret_token when calling
# Telegram's setWebhook. The webhook route rejects any request whose
# X-Telegram-Bot-Api-Secret-Token header doesn't match this exactly.
TELEGRAM_WEBHOOK_SECRET=""

# Groq API key — powers voice-message transcription (whisper-large-v3) for
# the Telegram AI Voice Invoice bot. Server-side only.
# Get one at https://console.groq.com.
GROQ_API_KEY=""

# This deployment's own public HTTPS origin (no trailing slash), e.g.
# "https://systemano.example.com". Used to build the Telegram Mini App
# "web_app" button URL sent by the bot — Telegram requires an https:// URL,
# so this can't be inferred from the incoming request.
APP_URL=""